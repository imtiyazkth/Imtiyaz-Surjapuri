# ─────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env.local and fill in your values.
#                  NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (safe to expose in browser) ───────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → SDK setup

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdefabcdef

# ── Firebase Admin SDK (SERVER-ONLY — never prefix with NEXT_PUBLIC_) ─────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key (download the JSON, copy the values below)

FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Note: Keep the quotes and \n characters exactly as shown above.

# ── Site settings ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://imtiyazsurjapuri.com
NEXT_PUBLIC_SITE_NAME=ImtiyazSurjapuri.com
NEXT_PUBLIC_TWITTER_HANDLE=@ImtiyazSurjapuri

# ── Google Analytics 4 (optional, for tracking) ───────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google AdSense (add when approved) ────────────────────────────────────
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
