rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────

    // Is the request authenticated at all?
    function isSignedIn() {
      return request.auth != null;
    }

    // Does this user have an admin or editor role in the users collection?
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    // Is the document a published article?
    function isPublished() {
      return resource.data.status == 'published';
    }

    // Validate social link domains — only allow known safe domains
    function isSafeSocialLinks(data) {
      return !('socialLinks' in data) ||
        (data.socialLinks is map);
    }

    // ─────────────────────────────────────────────────────
    // ARTICLES
    // Anyone can read published articles.
    // Only admin/editor can read all, create, update, delete.
    // ─────────────────────────────────────────────────────
    match /articles/{articleId} {
      allow read: if isPublished() || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'slug', 'status', 'author', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.status in ['draft', 'published', 'archived', 'scheduled'];
      allow update: if isAdmin()
        && request.resource.data.status in ['draft', 'published', 'archived', 'scheduled'];
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // CATEGORIES
    // Anyone can read. Only admin can write.
    // ─────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // TAGS
    // Anyone can read. Only admin can write.
    // ─────────────────────────────────────────────────────
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // SETTINGS
    // Anyone can read. Only admin can write.
    // ─────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // ANNOUNCEMENTS
    // Public can read active announcements.
    // Admin can do anything.
    // ─────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // LIKES
    // Anyone can create (like). No one can update.
    // Admin can delete. Compound ID prevents duplicates.
    // ─────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['postId', 'visitorId', 'createdAt'])
        && request.resource.data.postId is string
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 64;
      allow update: if false; // likes cannot be modified, only created/deleted
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // FEEDBACK / CONTACT FORM
    // Anyone can create (submit form). Only admin can read.
    // ─────────────────────────────────────────────────────
    match /feedback/{docId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'type', 'createdAt', 'read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.type in ['contact', 'newsletter']
        && request.resource.data.read == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // ANALYTICS
    // Only admin can read/write analytics data.
    // ─────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // USERS
    // Users can read their own document.
    // Only admin can create/update/delete user documents.
    // ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // DEFAULT: deny everything not explicitly allowed
    // ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
